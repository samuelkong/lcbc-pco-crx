	// Background, Scripts & Net Request Rules

	//"background": {},
	"content_scripts": [
		{
			"matches": ["https://lagunabaptist.churchcenter.com/people/forms/*"],
			"js" : ["lib/jquery-4.0.0.min.js", "scripts/content.js"]
		}
	],
	//"declarative_net_request": {},

