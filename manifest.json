{
	// Required

	"manifest_version": 3,
	"name": "LCBC PCO",
	"version": "0.1.0",

	// General

	"description": "Customization for new children registration form.",
	//"default_locale": "en",
	"icons": {
		"16": "images/icon-16.png",
		"32": "images/icon-32.png",
		"48": "images/icon-48.png",
		"128": "images/icon-128.png"
	},
	"author": "Samuel Kong",
	"homepage_url": "https://lagunabaptist.org",

	// UI & Action

	"action": {
		"default_icon": "images/icon-128.png",
		"default_popup": "popup/popup.html"
	},
