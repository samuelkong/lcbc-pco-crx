{
	// Required

	"manifest_version": 3,
	"name": "LCBC PCO",
	"version": "1.0.0",

	// General

	"description": "Customization for new children registration form.",
	"icons": {
		"16": "images/icon-16.png",
		"32": "images/icon-32.png",
		"48": "images/icon-48.png",
		"128": "images/icon-128.png"
	},
	"author": "Samuel Kong",
	"homepage_url": "https://lagunabaptist.org",

	// UI & Action

	"action": {
		"default_icon": "images/icon-128.png"
	},

	// Background, Scripts & Net Request Rules

	"content_scripts": [
		{
			"matches": ["https://lagunabaptist.churchcenter.com/people/forms/*"],
			"css" : ["scripts/content.css"],
			"run_at": "document_start"
		},
		{
			"matches": ["https://lagunabaptist.churchcenter.com/people/forms/*"],
			"js" : [
				"lib/jquery-4.0.0.min.js",
				"scripts/LanguageUtil.js",
				"scripts/LanguageSwitcher.js",
				"scripts/content.js"
			]
		}
	],

	// Resources & Shortcuts

	"web_accessible_resources": [
		{
			"matches": ["https://lagunabaptist.churchcenter.com/*"],
			"resources": ["images/*"]
		}
	]
}